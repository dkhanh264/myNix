configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "󰀻";
    display-run:                "󰌨";
    display-filebrowser:        "󰉋";
    display-window:             "󱂬";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    drun-match-fields:          "name,generic,exec,categories,keywords";
}

@import "/home/dk/.config/current/wal-colors.rasi"

* {
    font:                       "Noto Sans 12";
    background-color:           transparent;
    text-color:                 var(fg-col);
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      650px;
    x-offset:                   0px;
    y-offset:                   0px;

    enabled:                    true;
    margin:                     0px;
    padding:                    0px;
    border:                     2px solid;
    border-radius:              28px;
    border-color:               var(border-col);
    cursor:                     "default";
    background-color:           var(bg-col);
}

mainbox {
    enabled:                    true;
    spacing:                    16px;
    margin:                     0px;
    padding:                    24px;
    border:                     0px solid;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    margin:                     0px;
    padding:                    12px 18px;
    border:                     1px solid;
    border-radius:              24px;
    border-color:               var(border-col);
    background-color:           var(bg-search);
    text-color:                 var(fg-col);
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 var(primary-col);
    font:                       "Noto Sans Bold 13";
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 var(fg-col);
    cursor:                     text;
    placeholder:                "Search apps...";
    placeholder-color:          var(fg-muted);
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      7;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    
    spacing:                    6px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    background-color:           transparent;
    text-color:                 var(fg-col);
    cursor:                     "default";
}

element {
    enabled:                    true;
    spacing:                    14px;
    margin:                     0px;
    padding:                    10px 16px;
    border:                     1px solid;
    border-radius:              18px;
    border-color:               transparent;
    background-color:           transparent;
    text-color:                 var(fg-col);
    cursor:                     pointer;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 var(fg-col);
    border-color:               transparent;
}

element normal.urgent,
element alternate.urgent {
    background-color:           transparent;
    text-color:                 var(urgent-col);
    border-color:               transparent;
}

element normal.active,
element alternate.active {
    background-color:           transparent;
    text-color:                 var(primary-col);
    border-color:               transparent;
}

element selected.normal,
element selected.active {
    background-color:           var(bg-selected);
    border-color:               var(border-selected);
    text-color:                 var(primary-col);
}

element selected.urgent {
    background-color:           var(bg-selected);
    border-color:               var(border-selected);
    text-color:                 var(urgent-col);
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       32px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    font:                       "Noto Sans SemiBold 12";
}

element selected.normal element-text,
element selected.active element-text {
    text-color:                 var(primary-col);
}
